# Public
APP_BASE_URL=http://localhost
PUBLIC_API_BASE_URL=http://localhost/api/v1
APP_ENV=development
TZ=Europe/Moscow

# PostgreSQL bootstrap
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_postgres
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change_me_n8n
APP_DB_NAME=inspection
APP_DB_USER=inspection_app
APP_DB_PASSWORD=change_me_app
APP_DB_READONLY_USER=inspection_readonly
APP_DB_READONLY_PASSWORD=change_me_readonly

# n8n
N8N_ENCRYPTION_KEY=replace_with_a_32_plus_character_random_value
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_LOG_LEVEL=info
N8N_EXECUTIONS_MODE=queue

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_DB_N8N=0
REDIS_DB_APP=1

# MinIO
MINIO_ROOT_USER=change_me_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_DERIVED=derived
MINIO_BUCKET_EXPORTS=exports

# Internal services
INTERNAL_API_TOKEN=replace_with_a_random_internal_token
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=200
PRESIGNED_URL_TTL_SECONDS=900
OCR_LANGUAGES=rus+eng
OCR_DPI=300
OCR_TIMEOUT_SECONDS=120
ENABLE_OCR=true
ENABLE_LLM=false
ENABLE_EMBEDDINGS=false
ENABLE_AUTH=false
